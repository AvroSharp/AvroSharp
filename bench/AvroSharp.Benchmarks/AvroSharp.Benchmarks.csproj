<Project Sdk="Microsoft.NET.Sdk">

  <!-- Multi-targeted so BenchmarkDotNet can run every scenario on each supported modern runtime (the runtimes option). -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- BenchmarkDotNet generates and builds its own project; it cannot sign with our key. -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="Chr.Avro.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvroSharp\AvroSharp.csproj" />
  </ItemGroup>

  <!-- The generated benchmark type (bench.generated.Order) comes from the source generator, as in a consumer project. -->
  <Import Project="..\..\build\UseLocalGenerator.targets" />

  <ItemGroup>
    <AdditionalFiles Include="Schemas\*.avsc" />
  </ItemGroup>

</Project>
