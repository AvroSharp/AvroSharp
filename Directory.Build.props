<Project>

  <!-- Shared settings for every project in the repository. -->
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Features>strict</Features>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!-- netstandard's BCL has no nullability annotations, so '!' suppressions that net8+ needs look unnecessary
       there (IDE0370, enforced by AnalysisLevel 11). -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('netstandard'))">
    <NoWarn>$(NoWarn);IDE0370</NoWarn>
  </PropertyGroup>

  <!-- BenchmarkDotNet generates and builds its own project under artifacts/, which inherits this file.
       Our documentation and analyzer rules are not meant for generated benchmark harness code. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'BenchmarkDotNet.Autogenerated'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RunAnalyzers>false</RunAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)build/TargetFrameworks.props" />

  <!-- Package metadata. The trademark wording is deliberate: AvroSharp implements the
       Apache Avro specification and is not an Apache Software Foundation project. -->
  <PropertyGroup>
    <Authors>zcsizmadia</Authors>
    <Copyright>Copyright (c) zcsizmadia and AvroSharp contributors</Copyright>
    <Product>AvroSharp</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AvroSharp/AvroSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AvroSharp/AvroSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>avro;serialization;binary;schema;dotnet</PackageTags>
    <Description>A high-performance .NET implementation of the Apache Avro™ specification.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Versioning from git tags (vX.Y.Z). -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <!-- Strong naming. The key pair is committed on purpose (common practice for OSS libraries);
       it provides identity for .NET Framework consumers, not security. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)build\AvroSharp.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
