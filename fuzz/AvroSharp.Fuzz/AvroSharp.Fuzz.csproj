<Project Sdk="Microsoft.NET.Sdk">

  <!-- libFuzzer harness (SharpFuzz). Run locally; see fuzz/README.md. The targets also run as a mutation smoke test
       in tests/AvroSharp.Tests on every build. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvroSharp\AvroSharp.csproj" />
  </ItemGroup>

</Project>
