<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The target framework set differs per OS (net481 on Windows only), so a single lock file cannot describe it. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- Documentation file stays on so IDE0005 runs on build; test code need not be documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- .NET Framework reference assemblies so net4x targets also build off Windows. -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
