{"type": "record", "name": "Customer", "namespace": "com.acme.crm", "aliases": ["com.acme.Client"],
 "x-owner": "crm-team",
 "fields": [
  {"name": "id", "type": {"type": "long", "logicalType": "timestamp-millis"}},
  {"name": "name", "type": "string", "aliases": ["full_name"], "order": "descending"},
  {"name": "balance", "type": {"type": "bytes", "logicalType": "decimal", "precision": 12, "scale": 2}, "default": "\u0000"},
  {"name": "score", "type": "double", "default": 1.5},
  {"name": "big", "type": "double", "default": 1e10},
  {"name": "count", "type": "long", "default": 9007199254740993},
  {"name": "tags", "type": {"type": "array", "items": "string"}, "default": []},
  {"name": "attributes", "type": {"type": "map", "values": "int", "x-note": "counts"}, "default": {"a": 1}},
  {"name": "hash", "type": {"type": "fixed", "name": "Hash", "size": 4}, "default": "abcd"},
  {"name": "home", "type": "com.acme.common.Address"},
  {"name": "work", "type": ["null", "com.acme.common.Address"], "default": null}
 ]}
