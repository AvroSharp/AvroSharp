<Project Sdk="Microsoft.NET.Sdk">

  <!-- net481 exercises the netstandard2.0 build of AvroSharp on .NET Framework (Windows only). -->
  <PropertyGroup>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(TargetFrameworks);net481</TargetFrameworks>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvroSharp\AvroSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\TestData\**\*" LinkBase="TestData" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The fuzz targets, run by FuzzSmokeTests with seeded mutations. -->
  <ItemGroup>
    <Compile Include="..\..\fuzz\AvroSharp.Fuzz\FuzzTargets.cs" Link="Fuzz\FuzzTargets.cs" />
  </ItemGroup>

</Project>
