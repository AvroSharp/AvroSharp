<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-checks AvroSharp against the Apache.Avro reference implementation (test-only dependency). -->
  <PropertyGroup>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- Apache.Avro is not strong-name-compatible with our signing requirements in every configuration. -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Apache.Avro" />
    <!-- Confluent's serializer, to check that Confluent framing is byte-identical to it. -->
    <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro" />
    <PackageReference Include="Apache.Avro.File.Snappy" />
    <PackageReference Include="Apache.Avro.File.BZip2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvroSharp\AvroSharp.csproj" />
    <ProjectReference Include="..\..\src\AvroSharp.Codecs\AvroSharp.Codecs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\TestData\**\*" LinkBase="TestData" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
