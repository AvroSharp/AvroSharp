<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the source generator in-process with Roslyn: diagnostics, snapshots and incremental caching. -->
  <PropertyGroup>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvroSharp\AvroSharp.csproj" />
    <ProjectReference Include="..\..\src\AvroSharp.Generators\AvroSharp.Generators.csproj" />
    <ProjectReference Include="..\..\src\AvroSharp.CodeGen\AvroSharp.CodeGen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Snapshots\*.cs" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Snapshots\*.cs" />
    <!-- Random values of any schema, shared with the interop and consumer tests. -->
    <Compile Include="..\AvroSharp.Interop.Tests\RandomValues.cs" Link="RandomValues.cs" />
    <None Include="..\AvroSharp.Generators.Consumer.Tests\Schemas\*.avsc" Link="ConsumerSchemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
