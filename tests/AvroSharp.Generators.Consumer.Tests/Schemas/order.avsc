{
  "type": "record",
  "name": "Order",
  "namespace": "shop",
  "doc": "An order <with> markup & a\nsecond line.",
  "fields": [
    {"name": "id", "type": "long", "doc": "The order id."},
    {"name": "active", "type": "boolean"},
    {"name": "count", "type": "int"},
    {"name": "ratio", "type": "float"},
    {"name": "total", "type": "double"},
    {"name": "payload", "type": "bytes"},
    {"name": "customer_name", "type": "string"},
    {"name": "status", "type": {"type": "enum", "name": "Status", "symbols": ["NEW", "PAID", "class"]}},
    {"name": "sku", "type": {"type": "fixed", "name": "Sku", "size": 4}},
    {"name": "counters", "type": {"type": "array", "items": "long"}},
    {"name": "small", "type": {"type": "array", "items": "int"}},
    {"name": "weights", "type": {"type": "array", "items": "double"}},
    {"name": "ratios", "type": {"type": "array", "items": "float"}},
    {"name": "flags", "type": {"type": "array", "items": "boolean"}},
    {"name": "tags", "type": {"type": "array", "items": "string"}},
    {"name": "lines", "type": {"type": "array", "items": {"type": "record", "name": "Line", "fields": [
      {"name": "sku", "type": "Sku"}, {"name": "qty", "type": "int"}, {"name": "note", "type": ["null", "string"]}]}}},
    {"name": "attributes", "type": {"type": "map", "values": "int"}},
    {"name": "groups", "type": {"type": "map", "values": {"type": "array", "items": "string"}}},
    {"name": "note", "type": ["null", "string"]},
    {"name": "discount", "type": ["null", "double"]},
    {"name": "priority", "type": ["int", "null"]},
    {"name": "shipping", "type": ["null", "Line"]},
    {"name": "extra", "type": ["null", "int", "string", "Sku", "Line", {"type": "array", "items": "long"}, {"type": "map", "values": "string"}]},
    {"name": "only", "type": ["string"]},
    {"name": "nothing", "type": "null"},
    {"name": "created", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "day", "type": {"type": "int", "logicalType": "date"}},
    {"name": "ref", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 10, "scale": 2}},
    {"name": "order", "type": "int", "doc": "Same name as the type: generated as Order_."},
    {"name": "schema", "type": "string", "doc": "Clashes with the generated Schema property."}
  ]
}
