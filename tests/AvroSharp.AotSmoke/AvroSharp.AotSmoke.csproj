<Project Sdk="Microsoft.NET.Sdk">

  <!-- Published with Native AOT in CI; any trim/AOT warning fails the build (warnings are errors). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvroSharp\AvroSharp.csproj" />
    <ProjectReference Include="..\..\src\AvroSharp.Codecs\AvroSharp.Codecs.csproj" />
    <TrimmerRootAssembly Include="AvroSharp" />
    <TrimmerRootAssembly Include="AvroSharp.Codecs" />
  </ItemGroup>

</Project>
