<?xml version="1.0" encoding="utf-8"?>
<!-- The AvroSharp packages come only from the packed folder, so the consumers test what was just packed, never a
     published version; everything else comes from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="packed" value="../../artifacts/package/release" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="packed">
      <package pattern="AvroSharp*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
