<Project Sdk="Microsoft.NET.Sdk">

  <!-- An application using the packed source generator, codecs, Confluent serde, KafkaFlow middleware, and the Azure
       and AWS Glue schema registry serializers (#136). It runs on .NET 10 and on .NET 8, so both the net10.0 and the
       net8.0 builds of the packages are used. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvroSharp.Generators" Version="$(AvroSharpVersion)" />
    <PackageReference Include="AvroSharp.Codecs" Version="$(AvroSharpVersion)" />
    <PackageReference Include="AvroSharp.Confluent" Version="$(AvroSharpVersion)" />
    <PackageReference Include="AvroSharp.KafkaFlow" Version="$(AvroSharpVersion)" />
    <PackageReference Include="AvroSharp.Azure.SchemaRegistry" Version="$(AvroSharpVersion)" />
    <PackageReference Include="AvroSharp.Aws.Glue" Version="$(AvroSharpVersion)" />
    <PackageReference Include="AvroSharp.Aws.Glue.Kafka" Version="$(AvroSharpVersion)" />
    <AdditionalFiles Include="Schemas\*.avsc" />
  </ItemGroup>

</Project>
