<Project Sdk="Microsoft.NET.Sdk">

  <!-- A .NET 10 application using the packed source generator and codecs (#136). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvroSharp.Generators" Version="$(AvroSharpVersion)" />
    <PackageReference Include="AvroSharp.Codecs" Version="$(AvroSharpVersion)" />
    <AdditionalFiles Include="Schemas\*.avsc" />
  </ItemGroup>

</Project>
