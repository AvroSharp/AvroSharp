<Project Sdk="Microsoft.NET.Sdk">

  <!-- The avrosharp tool, run in-process through Cli.Run: output, errors and exit codes of every command. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvroSharp.Tool\AvroSharp.Tool.csproj" />
  </ItemGroup>

  <!-- Container files written by Apache's and Java's tools, for the file commands. -->
  <ItemGroup>
    <None Include="..\TestData\apache-avro\weather*" LinkBase="TestData\apache-avro" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestData\java-avro\*" LinkBase="TestData\java-avro" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
