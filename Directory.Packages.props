<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled Condition="'$(CentralPackageTransitivePinningEnabled)' == ''">true</CentralPackageTransitivePinningEnabled>
    <!-- The Confluent version the build uses. AvroSharp.Confluent depends on [2.14.0, 3.0.0): 2.14.0 changed the serde
         base classes' protected members in a minor release (GetSubjectName became async), so older versions can't load
         it. To build and test against the lowest: -p:ConfluentVersion=2.14.0. -->
    <ConfluentVersion Condition="'$(ConfluentVersion)' == ''">2.15.1</ConfluentVersion>
    <!-- The versions the tests use of the add-ons' other dependencies, so CI can also test the lowest each package
         accepts: -p:KafkaFlowVersion=4.0.0 (with ConfluentVersion=2.14.0), -p:AzureSchemaRegistryVersion=1.2.0 and
         -p:AwsGlueVersion=4.0.0 (#215). -->
    <KafkaFlowVersion Condition="'$(KafkaFlowVersion)' == ''">4.2.0</KafkaFlowVersion>
    <AzureSchemaRegistryVersion Condition="'$(AzureSchemaRegistryVersion)' == ''">1.4.0</AzureSchemaRegistryVersion>
    <AwsGlueVersion Condition="'$(AwsGlueVersion)' == ''">4.0.111</AwsGlueVersion>
  </PropertyGroup>

  <!-- Build tooling and analyzers -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Polyfill" Version="11.4.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.291" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <!-- netstandard polyfills for shipped libraries -->
  <ItemGroup>
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageVersion Include="System.Threading.Channels" Version="10.0.12" />
  </ItemGroup>

  <!-- AvroSharp.Codecs: fully managed compression libraries only (docs/design.md, decision 1). Each is the lowest
       version the codecs need; consumers may take newer ones. -->
  <ItemGroup>
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="Snappiest" Version="0.9.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="Lzma.Net" Version="5.8.4.3" />
  </ItemGroup>

  <!-- AvroSharp.Confluent. The package itself references [2.14.0, 3.0.0) through VersionOverride. -->
  <ItemGroup>
    <PackageVersion Include="Confluent.SchemaRegistry" Version="$(ConfluentVersion)" />
  </ItemGroup>

  <!-- AvroSharp.KafkaFlow. The package itself references [4.0.0, 5.0.0) through VersionOverride. -->
  <ItemGroup>
    <PackageVersion Include="KafkaFlow.SchemaRegistry" Version="$(KafkaFlowVersion)" />
  </ItemGroup>

  <!-- AvroSharp.Azure.SchemaRegistry. The package itself references [1.2.0, 2.0.0) through VersionOverride. -->
  <ItemGroup>
    <PackageVersion Include="Azure.Data.SchemaRegistry" Version="$(AzureSchemaRegistryVersion)" />
  </ItemGroup>

  <!-- AvroSharp.Aws.Glue and AvroSharp.Aws.Glue.Kafka. The packages themselves reference AWSSDK.Glue [4.0.0, 5.0.0)
       and Confluent.Kafka [2.0.2, 3.0.0) through VersionOverride. -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.Glue" Version="$(AwsGlueVersion)" />
    <PackageVersion Include="AWSSDK.Core" Version="4.0.102.8" />
  </ItemGroup>

  <!-- Command-line tool -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <!-- Tests and benchmarks only; never referenced from src/ (enforced in Directory.Build.targets). -->
  <ItemGroup>
    <PackageVersion Include="TUnit" Version="1.72.16" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="Chr.Avro.Json" Version="10.13.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Apache.Avro" Version="1.12.2" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Avro" Version="$(ConfluentVersion)" />
    <PackageVersion Include="Confluent.SchemaRegistry.Rules" Version="$(ConfluentVersion)" />
    <PackageVersion Include="Confluent.SchemaRegistry.Encryption" Version="$(ConfluentVersion)" />
    <PackageVersion Include="Confluent.Kafka" Version="$(ConfluentVersion)" />
    <PackageVersion Include="Testcontainers.Redpanda" Version="4.15.0" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="KafkaFlow.Serializer.SchemaRegistry.ConfluentAvro" Version="$(KafkaFlowVersion)" />
    <PackageVersion Include="KafkaFlow.Microsoft.DependencyInjection" Version="$(KafkaFlowVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Azure.Data.SchemaRegistry.ApacheAvro" Version="1.0.1" />
    <PackageVersion Include="Azure.Messaging.EventHubs" Version="5.12.2" />
    <!-- Brought in by Confluent.SchemaRegistry.Encryption's dependencies at 4.7.0, which has a critical advisory. -->
    <PackageVersion Include="System.Drawing.Common" Version="4.7.2" />
    <!-- Brought in on .NET Framework by Confluent.SchemaRegistry.Rules (through Cel.NET, Antlr4BuildTasks and
         Microsoft.Build.Utilities.Core) at 6.0.0, which has a high advisory. -->
    <PackageVersion Include="Microsoft.IO.Redist" Version="6.1.0" />
    <PackageVersion Include="Apache.Avro.File.Snappy" Version="1.12.2" />
    <PackageVersion Include="Apache.Avro.File.BZip2" Version="1.12.2" />
    <PackageVersion Include="Apache.Avro.File.XZ" Version="1.12.2" />
    <PackageVersion Include="Apache.Avro.File.Zstandard" Version="1.12.2" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

</Project>
