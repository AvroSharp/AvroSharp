<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# code generation engine: schemas in, source text out. No Roslyn dependency, so the source generator and
       the command-line tool share it. netstandard2.0 because it runs inside the compiler; net8.0 so that .NET 8 and
       later use the framework's System.Text.Json, which the netstandard2.0 build, compiled against its 10.x package,
       could not load there. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>AvroSharp.CodeGen</RootNamespace>
    <PackageId>AvroSharp.CodeGen</PackageId>
    <Description>C# code generation from Apache Avro™ schemas, used by the AvroSharp source generator and tools.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvroSharp\AvroSharp.csproj" />
  </ItemGroup>

  <!-- The attribute-driven generator emits through the internal declared-type entry point. It ships its own copy of
       this assembly, so the two always match. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AvroSharp.Generators" Key="" />
    <InternalsVisibleTo Include="AvroSharp.Generators.Tests" Key="" />
  </ItemGroup>

</Project>
