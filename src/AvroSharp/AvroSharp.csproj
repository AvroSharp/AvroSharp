<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AvroSharp</RootNamespace>
    <PackageId>AvroSharp</PackageId>
  </PropertyGroup>

  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- Unit tests of internal helpers whose behaviour depends on the machine (for example the CPU checks in FastBmi2). -->
  <ItemGroup>
    <InternalsVisibleTo Include="AvroSharp.Tests" Key="" />
  </ItemGroup>

</Project>
