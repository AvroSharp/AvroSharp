<Project>

  <!-- Lets the generator read its MSBuild properties (see the Code generation docs). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="AvroSharpNamespace" />
    <CompilerVisibleProperty Include="AvroSharpNamespaceMap" />
    <CompilerVisibleProperty Include="AvroSharpLogicalTypes" />
    <CompilerVisibleProperty Include="AvroSharpApacheCompatible" />
    <CompilerVisibleProperty Include="AvroSharpPropertyNames" />
  </ItemGroup>

</Project>
