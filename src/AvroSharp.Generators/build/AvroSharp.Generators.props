<Project>

  <!-- Lets the generator read its MSBuild properties (see the Code generation docs). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="AvroSharpNamespace" />
    <!-- AvroSharpNamespaceMap, as the .targets passes it on in a form the compiler keeps. -->
    <CompilerVisibleProperty Include="_AvroSharpNamespaceMap" />
    <CompilerVisibleProperty Include="AvroSharpLogicalTypes" />
    <CompilerVisibleProperty Include="AvroSharpApacheCompatible" />
    <CompilerVisibleProperty Include="AvroSharpPropertyNames" />
    <CompilerVisibleProperty Include="AvroSharpRequiredMembers" />
    <CompilerVisibleProperty Include="AvroSharpTypeKind" />
    <CompilerVisibleProperty Include="AvroSharpAccessibility" />
    <CompilerVisibleProperty Include="AvroSharpSealedTypes" />
  </ItemGroup>

  <!-- The same settings per schema file, as AdditionalFiles metadata, which override the project's (#18). -->
  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AvroSharpNamespace" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AvroSharpLogicalTypes" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AvroSharpPropertyNames" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AvroSharpApacheCompatible" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AvroSharpRequiredMembers" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AvroSharpTypeKind" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AvroSharpAccessibility" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AvroSharpSealedTypes" />
  </ItemGroup>

</Project>
