<Project Sdk="Microsoft.NET.Sdk">

  <!-- The avrosharp command-line tool (dotnet tool): C# code generation from .avsc files, and schema canonical forms
       and fingerprints. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>AvroSharp.Tool</RootNamespace>
    <PackageId>AvroSharp.Tool</PackageId>
    <Description>The avrosharp command-line tool: C# types and serializers from Apache Avro™ schema files (.avsc), and schema canonical forms and fingerprints.</Description>
    <PackageTags>$(PackageTags);codegen;cli;tool</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>avrosharp</ToolCommandName>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvroSharp.CodeGen\AvroSharp.CodeGen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvroSharp.Tool.Tests" Key="" />
  </ItemGroup>

</Project>
