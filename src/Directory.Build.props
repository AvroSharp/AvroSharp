<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shipped libraries. -->
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- The breaks since 0.2.0 are listed in each project's CompatibilitySuppressions.xml; the baseline becomes 1.0.0 after 1.0. -->
    <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <!-- Polyfill: include the ArgumentNullException/ArgumentOutOfRangeException ThrowIf* helpers. -->
    <PolyArgumentExceptions>true</PolyArgumentExceptions>
    <!-- Mark polyfill types [Embedded] so they never leak into, or clash with, consumers' own polyfills. -->
    <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- A package's README is the project's own README.md when it has one, and the repository README otherwise. -->
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildProjectDirectory)\README.md')" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" Condition="!Exists('$(MSBuildProjectDirectory)\README.md')" />
    <None Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- The analyzer package adds PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt as AdditionalFiles itself. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Visible="false" />
  </ItemGroup>

  <!-- Source-only polyfills for language features and newer BCL APIs; nothing is added where the TFM already has them. -->
  <ItemGroup>
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <Using Include="Polyfills" />
  </ItemGroup>

</Project>
