<Project Sdk="Microsoft.NET.Sdk">

  <!-- What an application writes to generate C# types from .avsc files. See README.md. In this repository,
       samples/Directory.Build.targets swaps the package for the generator built from source, so CI tests the current code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AvroSharpNamespace>Shop</AvroSharpNamespace>
    <AvroSharpNamespaceMap>
      com.example.shop:Shop.Orders;
      com.example.crm:Shop.Customers
    </AvroSharpNamespaceMap>
    <AvroSharpPropertyNames>pascal</AvroSharpPropertyNames>
    <AvroSharpLogicalTypes>native</AvroSharpLogicalTypes>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvroSharp.Generators" Version="*" />
    <AdditionalFiles Include="Schemas\*.avsc" />
  </ItemGroup>

</Project>
