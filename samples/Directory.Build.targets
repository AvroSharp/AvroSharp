<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.targets" />

  <!-- GeneratorPackage's project file is what an application writes, with the AvroSharp.Generators package. Here it
       builds with the generator and the runtime from source instead, so CI tests the current code. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'GeneratorPackage'">
    <PackageReference Remove="AvroSharp.Generators" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\AvroSharp\AvroSharp.csproj" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\build\UseLocalGenerator.targets" Condition="'$(MSBuildProjectName)' == 'GeneratorPackage'" />

</Project>
