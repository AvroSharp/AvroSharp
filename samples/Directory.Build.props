<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Runnable examples: run one with dotnet run in its folder. CI builds and runs each one, so they stay current.
       Each checks its own results and exits with 1 if one is wrong. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Samples need no API documentation, print literal strings, and are applications, which need no ConfigureAwait. -->
    <NoWarn>$(NoWarn);CS1591;CA1303;CA2007;MA0004</NoWarn>
  </PropertyGroup>

</Project>
